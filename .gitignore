# --- Autosave-Absicherung (2026-08-10) ---
# Diese Eintraege muessen stehen, bevor scripts/autosave_snapshot.ps1 laeuft.
# Ohne sie wuerde der Autosave-Task venvs und Caches im Minutentakt einchecken.

# Alle virtuellen Umgebungen (venv_mistral_gguf, venv_bot_20260802, kuenftige)
venv_*/
.venv/

# Backups liegen ausserhalb des Repos unter %USERPROFILE%\homebot_backups\.
# Eintrag bleibt, falls ein Agent den Ordner erneut im Repo anlegt.
backups/

# Archivierter toter Code
dead_code_archive/

# Werkzeug-Caches und Coverage-Reports
.pytest_cache/
htmlcov/
htmlcov_integration/

# Generierte mypy-Report-Dumps (Momentaufnahmen, kein Vertrag)
mypy_*.txt

# Temporaere Wegwerf-Skripte und -Dateien
_tmp_*

# --- Daten gehoeren nicht ins Repo (2026-08-10) ---
# Produktive DBs und Caches liegen unter dem .db_root-Ziel
# (%USERPROFILE%\.local\share\homebot_dbs). Pfade IMMER ueber
# utils/db_path_resolver beziehen. Der KG-Cache folgt automatisch
# dem Psycho-DB-Pfad und darf nie wieder eingecheckt werden.
psychological_support_kg_cache/
psycho_kg_faiss/

# --- Public Launch Hygiene (2026-08-31) ---
# Maschinen-/benutzerspezifische Runtime-Zustaende und lokale Arbeitsdateien
# duerfen nie ins (oeffentliche) Repository. Vorlagen: *.example-Dateien.
/.db_root
/monitoring/
/data/websearch_cache.json
/settings.json
/.continue/
/_search_tmp.txt
/config/path_allowlist.json
/marketing/
/.bm25s_index
# Ad-hoc agent diagnostic files (top-level only)
/_*.txt
