#!/bin/sh
#
# Pre-Push-Gate (portabel, fail-closed)
#
# Blockt den Push, wenn die zu pushenden Commits Secrets oder Private Keys
# einfuehren wuerden. Deckt auch `git commit --no-verify` und direkte
# `git push` ab (das pre-commit-Gate laeuft beim Push nicht mehr).
#
# stdin (von Git): je Zeile
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# Branch-Loeschungen (local_sha = 40x0) werden uebersprungen: sie entfernen
# Inhalt und koennen kein neues Secret einfuehren. Gleiches gilt in
# normalen Pushes fuer Loeschungen (diff-filter ACMR, siehe secret_guard.py).
#
# Fail-closed: kein Python oder Guard-Fehler (exit 2) -> Push blockiert.
#
# Aktiviert ueber:  git config core.hooksPath .githooks

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Python-Aufloesung: identische Reihenfolge wie .githooks/pre-commit.
PYTHON=""
if [ -n "$HOMEBOT_PYTHON" ] && [ -x "$HOMEBOT_PYTHON" ]; then
    PYTHON="$HOMEBOT_PYTHON"
else
    for cand in \
        "$REPO_ROOT/venv_bot_20260802/Scripts/python.exe" \
        "$REPO_ROOT/.venv/Scripts/python.exe" \
        "$REPO_ROOT/venv/Scripts/python.exe" \
        "$REPO_ROOT/venv_bot_20260802/bin/python" \
        "$REPO_ROOT/.venv/bin/python" \
        "$REPO_ROOT/venv/bin/python" \
        "$REPO_ROOT/venv_mistral_gguf/Scripts/python.exe"; do
        if [ -x "$cand" ]; then PYTHON="$cand"; break; fi
    done
fi
if [ -z "$PYTHON" ]; then
    PYTHON="$(command -v python 2>/dev/null || true)"
fi
if [ -z "$PYTHON" ]; then
    echo "pre-push: FEHLER (fail-closed): kein Python-Interpreter gefunden - Push blockiert." >&2
    echo "pre-push: HOMEBOT_PYTHON setzen oder venv anlegen (.venv/ bzw. venv/)." >&2
    exit 2
fi

ZERO="0000000000000000000000000000000000000000"
STATUS=0
CHECKED=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    if [ "$local_sha" = "$ZERO" ]; then
        continue  # Branch-Loeschung: entfernt Inhalt, einfuehren kann sie nichts.
    fi
    CHECKED=$((CHECKED + 1))
    "$PYTHON" scripts/secret_guard.py --push "$local_sha" "$remote_sha"
    RC=$?
    if [ $RC -ne 0 ]; then
        STATUS=$RC
    fi
done

if [ $CHECKED -eq 0 ]; then
    exit 0
fi
if [ $STATUS -ne 0 ]; then
    echo "" >&2
    echo "pre-push: SECRET-GATE ROT - Push blockiert." >&2
    echo "pre-push: Entferne das Secret aus der zu pushenden Historie" >&2
    echo "pre-push: (z. B. git rebase / git filter-repo) und rotiere den Key." >&2
    echo "pre-push: --no-verify hilft hier NICHT - das Gate laeuft vor dem Push." >&2
    exit $STATUS
fi
exit 0